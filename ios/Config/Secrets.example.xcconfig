// Copy to Config/Secrets.xcconfig (gitignored) and fill in, then run `xcodegen generate`.
// NOTE: "//" starts a comment in .xcconfig files, so write the URL with "$()" between the slashes.
SUPABASE_URL = https:/$()/YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY = YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

// --- Signing -------------------------------------------------------------
// Paid Apple Developer Program (Push + Sign in with Apple):
//   DEVELOPMENT_TEAM = ABCDE12345
//   PRODUCT_BUNDLE_IDENTIFIER = com.findme.app
//   FREE_TEAM = NO
//
// Free Personal Team (install on your own iPhone; Google + email OTP sign-in only, no push):
//   DEVELOPMENT_TEAM = ABCDE12345
//   PRODUCT_BUNDLE_IDENTIFIER = com.yourname.findme   (must be globally unique)
//   FREE_TEAM = YES
DEVELOPMENT_TEAM =
PRODUCT_BUNDLE_IDENTIFIER = com.findme.app
FREE_TEAM = NO
