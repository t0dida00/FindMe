{
  "sourceLanguage": "en",
  "strings": {
    "CFBundleDisplayName": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find Me!"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Find Me!"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find Me! uses the camera so you can photograph the proof sheet inside the app. Photos are only sent to the host for review."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Find Me! cần camera để bạn chụp ảnh tờ giấy mã ngay trong app. Ảnh chỉ được gửi cho quản trò duyệt."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your location is only shown on the map on this device and is never sent to the server."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vị trí của bạn chỉ được hiển thị trên bản đồ trong máy, không bao giờ gửi lên máy chủ."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hosts pick photos from the library for clue blocks (players never use the photo library)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quản trò chọn ảnh từ thư viện để làm khối gợi ý (người chơi không dùng thư viện ảnh)."
          }
        }
      }
    }
  },
  "version": "1.0"
}
